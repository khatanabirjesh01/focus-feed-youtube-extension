{
  "manifest_version": 3,
  "name": "FocusFeed - YouTube Feed & Distraction Filter",
  "short_name": "FocusFeed",
  "version": "1.0.0",
  "description": "Real-time, zero-API filter for YouTube.com: block Shorts, comments, channels, keywords, and topic fields.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "incognito": "spanning",
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusFeed Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
